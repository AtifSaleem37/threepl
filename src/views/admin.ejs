<!DOCTYPE html>
<html>
<head>
  <%- include('partials/head', { pageTitle: 'Admin' }) %>
</head>
<body>
<%- include('partials/header', {
      portalKey: 'admin', portalLabel: 'Admin',
      logoutAction: '/admin/logout', logoutLabel: 'Log out (' + user.username + ')'
    }) %>
<main>
  <nav class="tabs">
    <a href="/admin?tab=orders" class="<%= tab === 'orders' ? 'active' : '' %>">Orders</a>
    <a href="/admin?tab=client-user" class="<%= tab === 'client-user' ? 'active' : '' %>">Create Client</a>
    <a href="/admin?tab=staff" class="<%= tab === 'staff' ? 'active' : '' %>">Staff Users</a>
    <a href="/admin?tab=clients" class="<%= tab === 'clients' ? 'active' : '' %>">Clients &amp; Rates</a>
    <a href="/admin?tab=account" class="<%= tab === 'account' ? 'active' : '' %>">My Account</a>
  </nav>

  <% if (msg) { %><div class="flash ok"><%= msg %></div><% } %>
  <% if (err) { %><div class="flash err"><%= err %></div><% } %>

  <% if (tab === 'orders') { %>
  <div class="card">
    <div class="card-head">
      <h2>Orders</h2>
      <%- include('partials/search', { searchAction: '/admin', searchTab: 'orders' }) %>
    </div>
    <% if (q) { %>
      <p class="search-note"><strong><%= orders.length %></strong> result<%= orders.length === 1 ? '' : 's' %> for &ldquo;<%= q %>&rdquo;</p>
    <% } %>
    <div class="table-wrap">
      <table>
        <tr>
          <th>Invoice #</th><th>Client Name</th><th>Email</th><th>Store Name</th><th>Brand</th><th>ASIN(s)</th>
          <th>Prep Requirement</th><th>Qty</th><th>Total</th><th>Shipment Status</th>
          <th>Payment Status</th><th>Tracking ID</th><th>Carrier</th><th>Created</th><th>Updated</th>
        </tr>
        <% orders.forEach(o => { %>
        <tr>
          <td><a href="/invoices/<%= o.invoice_no %>.pdf"><%= o.invoice_no %></a></td>
          <td><%= o.name %></td>
          <td><%= o.email %></td>
          <td><%= o.store_name || '-' %></td>
          <td><%= o.brand_name || '-' %></td>
          <td><%= o.asin %></td>
          <td><%= o.prep_requirement %></td>
          <td><%= o.quantity %></td>
          <td>$<%= o.total.toFixed(2) %></td>
          <td><span class="badge <%= ['received','shipped','prep','prep_done','sent_to_amazon'].includes(o.shipment_status) ? o.shipment_status : 'status' %>"><%= shipLabels[o.shipment_status] || o.shipment_status %></span></td>
          <td><span class="badge <%= o.payment_status %>"><%= payLabels[o.payment_status] %></span></td>
          <td><%= o.tracking_id || '-' %></td>
          <td><%= o.carrier || '-' %></td>
          <td class="ts-cell"><%- include('partials/ts', { value: o.created_at }) %></td>
          <td class="ts-cell"><%- include('partials/ts', { value: o.updated_at || o.created_at }) %></td>
        </tr>
        <% }) %>
        <% if (orders.length === 0) { %><tr><td colspan="15"><%= q ? 'No orders match that client or brand name.' : 'No orders yet.' %></td></tr><% } %>
      </table>
    </div>
  </div>
  <% } %>

  <% if (tab === 'client-user') { %>
  <div class="card">
    <h2>Create Client Account</h2>
    <form method="post" action="/admin/clients">
      <input type="hidden" name="role" value="client">
      <div class="grid cols-2">
        <div><label>Client Name *</label><input name="client_name" required></div>
        <div><label>Business Name</label><input name="business_name"></div>
        <div><label>Email</label><input type="email" name="email"></div>
        <div><label>Store Name</label><input name="store_name"></div>
        <div><label>Username *</label><input name="username" required autocomplete="off"></div>
        <div><label>Password *</label><input name="password" required autocomplete="new-password"></div>
      </div>
      <br><button type="submit">Create client</button>
    </form>
  </div>
  <% } %>

  <% if (tab === 'staff') { %>
  <div class="card">
    <h2>Create Staff User</h2>
    <p><small class="hint">Accounts users verify client payments at /accounts. Warehouse users receive shipments and download FNSKU labels at /warehouse. P2P users manage purchase orders at /p2p. Only name, username and password are needed.</small></p>
    <form method="post" action="/admin/clients">
      <div class="grid cols-2">
        <div><label>Role *</label>
          <select name="role">
            <option value="accounts">Accounts (payment verification)</option>
            <option value="warehouse">Warehouse (receiving)</option>
            <option value="p2p">P2P (purchase orders)</option>
          </select>
        </div>
        <div><label>Name *</label><input name="client_name" required></div>
        <div><label>Username *</label><input name="username" required autocomplete="off"></div>
        <div><label>Password *</label><input name="password" required autocomplete="new-password"></div>
      </div>
      <br><button type="submit">Create staff user</button>
    </form>
  </div>

  <div class="card">
    <h2>Existing Staff Users</h2>
    <div class="table-wrap">
      <table>
        <tr><th>Role</th><th>Name</th><th>Username</th><th>Created</th><th>Reset password</th></tr>
        <% staffUsers.forEach(a => { %>
        <tr>
          <td><span class="badge status"><%= a.role %></span></td>
          <td><%= a.client_name %></td>
          <td><%= a.username %></td>
          <td><%= a.created_at.slice(0, 10) %></td>
          <td>
            <form class="inline-form" method="post" action="/admin/clients/<%= a.id %>/password?tab=staff">
              <input name="password" placeholder="New password" required>
              <button type="submit">Set</button>
            </form>
          </td>
        </tr>
        <% }) %>
        <% if (staffUsers.length === 0) { %><tr><td colspan="5">No staff users yet.</td></tr><% } %>
      </table>
    </div>
  </div>
  <% } %>

  <% if (tab === 'clients') { %>
  <div class="card">
    <h2>Global Rates (defaults)</h2>
    <form method="post" action="/admin/rates">
      <div class="grid cols-4">
        <div><label>Inbound Receiving ($/unit)</label>
          <input name="inbound" type="number" step="0.01" min="0" value="<%= rates.inbound %>"></div>
        <div><label>FNSKU Labeling ($/unit)</label>
          <input name="fnsku" type="number" step="0.01" min="0" value="<%= rates.fnsku %>"></div>
        <div><label>Polybagging ($/unit)</label>
          <input name="polybag" type="number" step="0.01" min="0" value="<%= rates.polybag %>"></div>
        <div><label>Cartonization ($/carton)</label>
          <input name="carton" type="number" step="0.01" min="0" value="<%= rates.carton %>"></div>
      </div>
      <br><button type="submit">Save global rates</button>
      <p><small class="hint">Polybagging is only charged when selected in the prep requirement. Cartons = quantity &divide; 50 (rounded up).</small></p>
    </form>
  </div>

  <div class="card">
    <h2>Volume Discount Tiers</h2>
    <p><small class="hint">The discount is chosen automatically from the <strong>total units</strong> on an order.
      It applies to every client - there is no per-client discount override. Quantity bands are fixed; edit the percentages here.</small></p>
    <form method="post" action="/admin/discount-tiers">
      <div class="grid cols-4">
        <% discountTiers.forEach((t, i) => { %>
          <div>
            <label><%= t.label %></label>
            <input name="t<%= i + 1 %>" type="number" step="0.1" min="0" max="100" value="<%= t.pct %>" required>
          </div>
        <% }) %>
      </div>
      <br><button type="submit">Save discount tiers</button>
      <p><small class="hint">Applied to the subtotal. Rates and the discount are snapshotted onto each order, so changes here never alter past invoices.</small></p>
    </form>
  </div>

  <div class="card">
    <h2>Clients &amp; Rate Overrides</h2>
    <div class="table-wrap">
      <table>
        <tr><th>Client</th><th>Business</th><th>Email</th><th>Store</th><th>Username</th>
            <th>Rate overrides (blank = global)</th><th>Reset password</th></tr>
        <% clients.forEach(c => { %>
        <tr>
          <td><%= c.client_name %></td>
          <td><%= c.business_name || '-' %></td>
          <td><%= c.email || '-' %></td>
          <td><%= c.store_name || '-' %></td>
          <td><%= c.username %></td>
          <td>
            <form class="inline-form" method="post" action="/admin/clients/<%= c.id %>/rates">
              <input name="inbound" type="number" step="0.01" min="0" placeholder="Inbound" value="<%= c.o_inbound ?? '' %>" title="Inbound $/unit">
              <input name="fnsku" type="number" step="0.01" min="0" placeholder="FNSKU" value="<%= c.o_fnsku ?? '' %>" title="FNSKU $/unit">
              <input name="polybag" type="number" step="0.01" min="0" placeholder="Polybag" value="<%= c.o_polybag ?? '' %>" title="Polybag $/unit">
              <input name="carton" type="number" step="0.01" min="0" placeholder="Carton" value="<%= c.o_carton ?? '' %>" title="Carton $/carton">
              <button type="submit">Save</button>
            </form>
          </td>
          <td>
            <form class="inline-form" method="post" action="/admin/clients/<%= c.id %>/password?tab=clients">
              <input name="password" placeholder="New password" required>
              <button type="submit">Set</button>
            </form>
          </td>
        </tr>
        <% }) %>
        <% if (clients.length === 0) { %><tr><td colspan="7">No clients yet.</td></tr><% } %>
      </table>
    </div>
  </div>
  <% } %>

  <% if (tab === 'account') { %>
  <div class="card">
    <h2>Change My Password</h2>
    <p><small class="hint">Signed in as <strong><%= user.username %></strong>.
      Your current password is required, and the new one must be at least
      <strong>8 characters</strong> containing both <strong>letters and numbers</strong>.</small></p>
    <form method="post" action="/admin/password" class="pw-form" autocomplete="off">
      <label>Current password *</label>
      <input type="password" name="current_password" autocomplete="current-password" required>

      <label>New password *</label>
      <input type="password" name="new_password" id="newPw"
             minlength="8" pattern="(?=.*[A-Za-z])(?=.*[0-9]).{8,}"
             title="At least 8 characters, including a letter and a number"
             autocomplete="new-password" required>

      <label>Confirm new password *</label>
      <input type="password" name="confirm_password" id="confirmPw"
             minlength="8" autocomplete="new-password" required>

      <ul class="pw-rules" id="pwRules">
        <li data-rule="len">At least 8 characters</li>
        <li data-rule="alpha">Contains a letter</li>
        <li data-rule="num">Contains a number</li>
        <li data-rule="match">Both entries match</li>
      </ul>

      <button type="submit">Update password</button>
    </form>
  </div>

  <script>
  (function () {
    var pw = document.getElementById('newPw');
    var cf = document.getElementById('confirmPw');
    var rules = {
      len: function (v) { return v.length >= 8; },
      alpha: function (v) { return /[A-Za-z]/.test(v); },
      num: function (v) { return /[0-9]/.test(v); },
      match: function (v) { return v.length > 0 && v === cf.value; }
    };
    // Live feedback only - the server re-checks every rule on submit.
    function sync() {
      var v = pw.value;
      document.querySelectorAll('#pwRules li').forEach(function (li) {
        li.classList.toggle('met', rules[li.dataset.rule](v));
      });
      cf.setCustomValidity(cf.value && cf.value !== v ? 'Passwords do not match' : '');
    }
    pw.addEventListener('input', sync);
    cf.addEventListener('input', sync);
    sync();
  })();
  </script>
  <% } %>
</main>
<%- include('partials/localtime') %>
</body>
</html>

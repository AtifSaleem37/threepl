<!DOCTYPE html>
<html>
<head>
  <%- include('partials/head', { pageTitle: 'P2P' }) %>
</head>
<body>
<%- include('partials/header', {
      portalKey: 'p2p', portalLabel: 'P2P',
      brandSub: '', headerNote: 'Purchase Orders',
      logoutAction: '/p2p/logout', logoutLabel: 'Log out (' + user.username + ')'
    }) %>
<main>
  <nav class="tabs">
    <a href="/p2p" class="<%= tab === 'orders' ? 'active' : '' %>">Purchase Orders</a>
    <a href="/p2p?tab=warehouse" class="<%= tab === 'warehouse' ? 'active' : '' %>">Warehouse Status</a>
  </nav>

  <% if (msg) { %><div class="flash ok"><%= msg %></div><% } %>
  <% if (err) { %><div class="flash err"><%= err %></div><% } %>

  <% if (tab === 'orders') { %>
  <div class="card">
    <div class="card-head">
      <h2>Purchase Orders</h2>
      <div class="head-tools">
        <%- include('partials/search', { searchAction: '/p2p' }) %>
        <button type="button" id="addPoBtn">+ Add PO</button>
      </div>
    </div>
    <% if (q) { %>
      <p class="search-note"><strong><%= pos.length %></strong> result<%= pos.length === 1 ? '' : 's' %> for &ldquo;<%= q %>&rdquo;</p>
    <% } %>

    <div class="table-wrap">
      <table>
        <tr>
          <th>PO #</th><th>Store</th><th>Brand</th><th>Items (ASIN / product / qty)</th><th>Total Qty</th>
          <th>Status</th><th>Tracking</th><th>History</th><th>Created</th><th>Updated</th><th>Action</th>
        </tr>
        <% pos.forEach(po => { %>
        <tr>
          <td><strong><%= po.po_number %></strong></td>
          <td><%= po.store_name %></td>
          <td><%= po.brand %></td>
          <td>
            <% (itemsByPo[po.id] || []).forEach(it => { %>
              <div class="po-item">
                <strong><%= it.asin %></strong> &middot; <%= it.product_name %>
                <span class="po-item-qty">&times; <%= it.quantity %></span>
              </div>
            <% }) %>
            <% if (!(itemsByPo[po.id] || []).length) { %><span class="hint">No items</span><% } %>
          </td>
          <td>
            <strong><%= po.total_qty %></strong>
            <div class="by-line"><%= po.item_count %> item<%= po.item_count === 1 ? '' : 's' %></div>
          </td>
          <td>
            <span class="badge <%= po.status %>"><%= poLabels[po.status] %></span>
            <div class="by-line">by <%= (eventsByPo[po.id] || []).slice(-1)[0] ? eventsByPo[po.id].slice(-1)[0].user_name : po.created_by_name %></div>
            <% if (po.pallets_sent > 0) { %>
              <div class="by-line"><%= po.pallets_sent %> of <%= po.pallets %> pallet(s) sent</div>
            <% } %>
          </td>
          <td>
            <% if (po.tracking_id) { %>
              <%= po.carrier %><br><%= po.tracking_id %><br>
              <small class="hint"><%= po.pallets %> pallet<%= po.pallets === 1 ? '' : 's' %></small>
            <% } else { %>-<% } %>
          </td>
          <td>
            <details>
              <summary><%= (eventsByPo[po.id] || []).length %> update<%= (eventsByPo[po.id] || []).length === 1 ? '' : 's' %></summary>
              <div class="po-history">
                <% (eventsByPo[po.id] || []).forEach(e => { %>
                  <div class="po-event">
                    <span class="badge <%= e.status %>"><%= poLabels[e.status] %></span>
                    <div class="po-event-meta">
                      <%= e.user_name %> &middot; <%- include('partials/ts', { value: e.created_at }) %>
                    </div>
                    <% if (e.detail) { %><div class="po-event-detail"><%= e.detail %></div><% } %>
                    <% if (e.photo) { %>
                      <a href="/po-photo/<%= e.id %>" target="_blank" rel="noopener">View photo</a>
                    <% } %>
                  </div>
                <% }) %>
              </div>
            </details>
          </td>
          <td class="ts-cell"><%- include('partials/ts', { value: po.created_at }) %></td>
          <td class="ts-cell"><%- include('partials/ts', { value: po.updated_at || po.created_at }) %></td>
          <td>
            <% const next = poNext[po.status]; %>
            <% if (next) { %>
              <form method="post" action="/p2p/pos/<%= po.id %>/advance"
                    enctype="multipart/form-data" class="advance-form">
                <input type="hidden" name="from" value="<%= po.status %>">
                <% if (next === 'shipped') { %>
                  <input name="carrier" placeholder="Carrier" required>
                  <input name="tracking_id" placeholder="Tracking ID" required>
                  <input name="pallets" type="number" min="1" step="1" inputmode="numeric"
                         pattern="\d+" placeholder="Pallets" title="Whole pallets, 1 or more" required>
                <% } %>
                <% if (next === 'sent_to_amazon') { %>
                  <label for="sent-<%= po.id %>">Pallets to send *</label>
                  <input name="pallets_sent" id="sent-<%= po.id %>" type="number" min="1" step="1"
                         inputmode="numeric" pattern="\d+"
                         max="<%= (po.pallets || 0) - (po.pallets_sent || 0) %>"
                         title="Whole pallets, 1 or more"
                         placeholder="of <%= (po.pallets || 0) - (po.pallets_sent || 0) %> left" required>
                <% } %>
                <% if (poPhotoRequired.includes(next)) { %>
                  <label for="photo-<%= po.id %>">Photo *</label>
                  <input type="file" id="photo-<%= po.id %>" name="photo"
                         accept="image/jpeg,image/png,image/webp,image/heic" required>
                <% } %>
                <button type="submit" class="small">Mark <%= poLabels[next] %></button>
              </form>
            <% } else { %>
              <span class="badge sent_to_amazon">Complete</span>
            <% } %>
          </td>
        </tr>
        <% }) %>
        <% if (pos.length === 0) { %>
          <tr><td colspan="11"><%= q ? 'No purchase orders match that search.' : 'No purchase orders yet - use + Add PO.' %></td></tr>
        <% } %>
      </table>
    </div>
    <p><small class="hint">Pipeline: PO placed &rarr; Shipped &rarr; Received &rarr; Prep in progress &rarr; Sent to Amazon.
      Every change records who made it. A photo is required for <strong>Received</strong> and
      <strong>Sent to Amazon</strong>; Shipped needs carrier, tracking ID and pallet count.
      Sending fewer pallets than were received leaves the PO <strong>Partially sent to Amazon</strong>,
      ready for the rest.</small></p>
  </div>
  <% } %>

  <% if (tab === 'warehouse') { %>
  <%- include('partials/warehouse-chart') %>
  <% } %>
</main>

<dialog id="newPoModal">
  <h3>New Purchase Order</h3>
  <form method="post" action="/p2p/pos">
    <div class="grid cols-3">
      <div><label>PO # *</label><input name="po_number" required autocomplete="off"></div>
      <div><label>Store Name *</label><input name="store_name" required autocomplete="off"></div>
      <div><label>Brand *</label><input name="brand" required autocomplete="off"></div>
    </div>

    <h4 class="po-products-heading">Products</h4>
    <div id="poProducts"></div>
    <button type="button" class="secondary small" id="addProductBtn">+ Add product</button>

    <p><small class="hint">PO number, store and brand apply to the whole PO; ASIN, product name
      and quantity vary per product. The PO is created at <strong>PO placed</strong>,
      recorded against your name.</small></p>
    <div class="dialog-actions">
      <button type="submit" id="placePoBtn" disabled>PO placed</button>
      <button type="button" class="secondary" id="closePoBtn">Cancel</button>
    </div>
  </form>

  <template id="poProductRow">
    <div class="po-product-row">
      <input name="__asin" placeholder="ASIN *" autocomplete="off" required>
      <input name="__product" placeholder="Product name *" autocomplete="off" required>
      <input name="__qty" type="number" min="1" step="1" inputmode="numeric"
             placeholder="Qty *" title="Whole units, 1 or more" required>
      <button type="button" class="secondary remove" title="Remove this product">&minus;</button>
    </div>
  </template>
</dialog>

<script>
(function () {
  var modal = document.getElementById('newPoModal');
  var form = modal.querySelector('form');
  var submit = document.getElementById('placePoBtn');
  var list = document.getElementById('poProducts');
  var tpl = document.getElementById('poProductRow');
  var idx = 0;

  // Submit stays disabled until the header and every product row are filled.
  function sync() {
    var ok = Array.prototype.slice.call(form.querySelectorAll('[required]'))
      .every(function (el) { return el.value.trim() !== ''; });
    submit.disabled = !ok || list.children.length === 0;
  }

  function addProduct() {
    var frag = tpl.content.cloneNode(true);
    frag.querySelector('[name="__asin"]').name = 'items[' + idx + '][asin]';
    frag.querySelector('[name="__product"]').name = 'items[' + idx + '][product_name]';
    frag.querySelector('[name="__qty"]').name = 'items[' + idx + '][quantity]';
    frag.querySelector('.remove').addEventListener('click', function (e) {
      // Never remove the last row - a PO must carry at least one product.
      if (list.children.length > 1) { e.target.closest('.po-product-row').remove(); sync(); }
    });
    list.appendChild(frag);
    idx++;
    sync();
  }

  form.addEventListener('input', sync);
  form.addEventListener('change', sync);
  document.getElementById('addProductBtn').addEventListener('click', addProduct);
  document.getElementById('addPoBtn').addEventListener('click', function () { modal.showModal(); sync(); });
  document.getElementById('closePoBtn').addEventListener('click', function () { modal.close(); });

  addProduct();
  <% if (openNew) { %>modal.showModal(); sync();<% } %>
})();
</script>
<%- include('partials/localtime') %>
</body>
</html>

<%#
  Warehouse capacity ring. Geometry comes from warehouseStatus() in server.js, so
  this template only draws. Two categorical hues (validated: CVD dE 24.7 / normal
  33.6 on white) carry the two real categories; free space is a neutral track, not
  a third category. Segments are separated by a 3px gap rather than a stroke.
-%>
<div class="card">
  <div class="card-head">
    <h2>Warehouse Status</h2>
    <span class="cap-note">Capacity <strong><%= wh.capacity %></strong> pallets</span>
  </div>

  <% if (wh.over > 0) { %>
    <div class="flash err">Over capacity: <%= wh.inWarehouse %> pallets on the floor,
      <%= wh.over %> above the <%= wh.capacity %>-pallet limit.</div>
  <% } else if (wh.overCommitted > 0) { %>
    <div class="flash err">Committed pallets (<%= wh.committed %>) exceed the
      <%= wh.capacity %>-pallet capacity by <%= wh.overCommitted %> once everything in transit lands.</div>
  <% } %>

  <div class="wh-grid">
    <figure class="wh-ring">
      <svg viewBox="0 0 200 200" role="img" width="200" height="200"
           aria-label="Warehouse capacity: <%= wh.inWarehouse %> pallets in warehouse, <%= wh.inTransit %> in transit, <%= wh.free %> free of <%= wh.capacity %>">
        <g transform="rotate(-90 100 100)">
          <% wh.arcs.forEach(a => { %>
            <circle cx="100" cy="100" r="<%= wh.radius %>"
                    fill="none" stroke="<%= a.color %>" stroke-width="22"
                    stroke-dasharray="<%= a.len.toFixed(2) %> <%= a.rest.toFixed(2) %>"
                    stroke-dashoffset="<%= a.offset.toFixed(2) %>">
              <title><%= a.label %>: <%= a.value %> pallet(s)</title>
            </circle>
          <% }) %>
        </g>
        <text x="100" y="94" text-anchor="middle" class="ring-hero"><%= wh.inWarehouse %></text>
        <text x="100" y="114" text-anchor="middle" class="ring-sub">of <%= wh.capacity %> pallets</text>
        <text x="100" y="130" text-anchor="middle" class="ring-sub2">in warehouse</text>
      </svg>
    </figure>

    <div class="wh-side">
      <ul class="wh-legend">
        <% wh.segments.forEach(seg => { %>
          <li>
            <span class="swatch" style="background:<%= seg.color %>"></span>
            <span class="legend-label"><%= seg.label %></span>
            <span class="legend-value"><%= seg.value %></span>
          </li>
        <% }) %>
      </ul>

      <div class="wh-stats">
        <div class="stat">
          <span class="stat-value"><%= wh.posOnFloor %></span>
          <span class="stat-label">PO<%= wh.posOnFloor === 1 ? '' : 's' %> in warehouse</span>
        </div>
        <div class="stat">
          <span class="stat-value"><%= wh.posInTransit %></span>
          <span class="stat-label">PO<%= wh.posInTransit === 1 ? '' : 's' %> in transit</span>
        </div>
        <div class="stat">
          <span class="stat-value"><%= wh.committed %></span>
          <span class="stat-label">Pallets committed</span>
        </div>
      </div>
    </div>
  </div>

  <div class="unit-strip">
    <div class="unit-hero">
      <span class="unit-value"><%= wh.unitsOnFloor.toLocaleString('en-US') %></span>
      <span class="unit-label">Units in warehouse</span>
      <span class="unit-note">across every ASIN, counted live</span>
    </div>
    <div class="unit-side">
      <span class="unit-value sm"><%= wh.unitsInTransit.toLocaleString('en-US') %></span>
      <span class="unit-label">Units in transit</span>
    </div>
  </div>

  <details class="wh-table">
    <summary>View as table</summary>
    <div class="table-wrap">
      <table>
        <tr><th>Measure</th><th>Pallets</th><th>Share of <%= wh.total %></th></tr>
        <% wh.segments.forEach(seg => { %>
          <tr>
            <td><span class="swatch" style="background:<%= seg.color %>"></span> <%= seg.label %></td>
            <td><%= seg.value %></td>
            <td><%= wh.total ? Math.round(seg.value / wh.total * 100) : 0 %>%</td>
          </tr>
        <% }) %>
        <tr><td><strong>Capacity</strong></td><td><strong><%= wh.capacity %></strong></td><td>&mdash;</td></tr>
      </table>
    </div>
  </details>

  <div class="movements">
    <div class="card-head">
      <h2>Received &amp; Sent to Amazon</h2>
      <form method="get" action="/p2p" class="date-filter">
        <input type="hidden" name="tab" value="warehouse">
        <label for="mvFrom">From</label>
        <input type="date" id="mvFrom" name="from" value="<%= mv.from %>" max="<%= mv.to %>">
        <label for="mvTo">To</label>
        <input type="date" id="mvTo" name="to" value="<%= mv.to %>" min="<%= mv.from %>">
        <button type="submit" class="small">Apply</button>
        <% if (!mv.isDefault) { %>
          <a class="search-clear" href="/p2p?tab=warehouse">Last 30 days</a>
        <% } %>
      </form>
    </div>

    <div class="wh-stats">
      <div class="stat">
        <span class="stat-value"><%= mv.received.units.toLocaleString('en-US') %></span>
        <span class="stat-label">Units received</span>
        <span class="stat-sub"><%= mv.received.events %> receipt<%= mv.received.events === 1 ? '' : 's' %>
          &middot; <%= mv.received.pos %> PO<%= mv.received.pos === 1 ? '' : 's' %></span>
      </div>
      <div class="stat">
        <span class="stat-value"><%= mv.sent.units.toLocaleString('en-US') %></span>
        <span class="stat-label">Units sent to Amazon</span>
        <span class="stat-sub"><%= mv.sent.events %> despatch<%= mv.sent.events === 1 ? '' : 'es' %>
          &middot; <%= mv.sent.pos %> PO<%= mv.sent.pos === 1 ? '' : 's' %></span>
      </div>
      <div class="stat">
        <span class="stat-value"><%= (mv.received.units - mv.sent.units).toLocaleString('en-US') %></span>
        <span class="stat-label">Net change</span>
        <span class="stat-sub">received minus sent</span>
      </div>
    </div>
    <% const unknown = (mv.received.unknown || 0) + (mv.sent.unknown || 0); %>
    <% if (unknown > 0) { %>
      <p><small class="hint"><%= unknown %> movement<%= unknown === 1 ? '' : 's' %> in this range
        predate per-event quantities and are not counted in the totals above.</small></p>
    <% } %>
    <p><small class="hint">Dates follow the stored UTC day, so a late-evening movement may fall on the next date.</small></p>
  </div>

  <p><small class="hint"><strong>In warehouse</strong> counts pallets received but not yet sent to Amazon,
    so a partially sent PO still occupies the remainder. <strong>In transit</strong> counts pallets on POs
    marked Shipped that have not arrived yet. Capacity is advisory &mdash; receiving is never blocked.</small></p>
</div>
